{
  "$id": "https://spec.aset.example/network/0.1/schemas/member-descriptor.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "constitution_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "context_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "policy_epoch": {
      "$ref": "common.schema.json#/$defs/epoch"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "WITHDRAWN"
      ]
    }
  },
  "required": [
    "context_id",
    "constitution_digest",
    "authority_digest",
    "policy_epoch",
    "status"
  ],
  "type": "object"
}
