{
  "activation_semantics": {
    "active_profile_registry_is_normative_state": false,
    "availability_implies_activation": false,
    "network_observation_implies_activation": false,
    "remote_recognition_implies_activation": false,
    "resolution_id_rule": "A fresh Seed resolution_id is required for each activation or reconsideration cycle.",
    "rule": "TARGET_LOCAL_SEED_ALLOW_ON_PROJECTED_EXACT_PROFILE_BINDING",
    "seed_binding_projection": {
      "binding_digest": "Seed canonical ResolutionBinding digest over the projected fields",
      "context_id": "ProfileBinding.target_context_id",
      "policy_epoch": "ProfileBinding.target_policy_epoch",
      "question_digest": "ProfileBinding.profile_digest",
      "scope": "ProfileBinding.seed_scope",
      "state_root": "ProfileBinding.target_state_root"
    },
    "verification_implies_activation": false
  },
  "claim_semantics": {
    "claim_type": "OPTIONAL_CAPABILITY_CLAIM",
    "normative_when_claimed": true,
    "required_for_core_conformance": false
  },
  "core_boundary": {
    "network_owned_activation_state": false,
    "network_state_fields_added": [],
    "network_transition_kinds_added": [],
    "profile_composition_algebra_defined": false,
    "runtime_plugin_lifecycle_defined": false
  },
  "digest_profile": {
    "canonicalization": "RFC8785_JSON_CANONICALIZATION_SCHEME",
    "hash": "SHA-256",
    "prefix": "sha256:",
    "rules": {
      "binding_digest": "SHA-256 of ProfileBinding with binding_digest omitted.",
      "profile_digest": "SHA-256 of ProfileDefinition with profile_digest omitted."
    }
  },
  "document_type": "aset-network-dynamic-profile-profile",
  "extension_version": "0.1.0-alpha.2",
  "non_goals": [
    "profile discovery",
    "profile negotiation",
    "dependency resolution",
    "profile precedence",
    "profile composition algebra",
    "runtime plugin installation lifecycle",
    "remote activation authority"
  ],
  "normative": true,
  "objects": {
    "profile_binding": {
      "content_addressed_profile_reference": true,
      "role": "EXACT_TARGET_LOCAL_SEED_BINDING",
      "schema": "extension/canonical/protocol/schemas/profile-binding.schema.json"
    },
    "profile_definition": {
      "content_addressed": true,
      "role": "IMMUTABLE_EXTERNAL_EVIDENCE",
      "schema": "extension/canonical/protocol/schemas/profile-definition.schema.json"
    }
  },
  "profile_id": "ASET-NETWORK-DYNAMIC-PROFILES-V1",
  "refinement_semantics": {
    "effect_rule": "PROFILE_PERMITTED_IMPLIES_PARENT_PERMITTED",
    "may_strengthen_parent": true,
    "may_supersede_seed": false,
    "may_weaken_parent": false
  },
  "revision_semantics": {
    "changed_definition_requires_new_digest": true,
    "definition_mutation_allowed": false,
    "new_digest_requires_new_exact_binding": true,
    "previous_allow_carries_forward": false
  },
  "schema_version": 1
}
