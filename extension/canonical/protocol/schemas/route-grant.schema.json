{
  "$id": "https://spec.aset.example/network/0.1/schemas/route-grant.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "grant_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "route_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "scope_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "source_context_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "source_policy_epoch": {
      "$ref": "common.schema.json#/$defs/epoch"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "SUSPENDED"
      ]
    },
    "target_context_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "target_policy_epoch": {
      "$ref": "common.schema.json#/$defs/epoch"
