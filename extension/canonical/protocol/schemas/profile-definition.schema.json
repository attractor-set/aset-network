{
  "$id": "https://spec.aset.example/network/0.1/schemas/profile-definition.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An immutable content-addressed profile manifest. profile_digest is the SHA-256 commitment to the RFC 8785 canonical object with profile_digest omitted. The object is evidence only; possession, transport or verification does not activate the profile.",
  "properties": {
    "invariants_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "parent_contract_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "profile_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "profile_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "profile_version": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "refinement_evidence_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "requirements_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "scope_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    }
  },
  "required": [
    "profile_id",
    "profile_version",
    "parent_contract_digest",
    "scope_digest",
    "requirements_digest",
    "invariants_digest",
    "profile_digest"
  ],
  "title": "ASET immutable dynamic profile definition",
  "type": "object"
}
