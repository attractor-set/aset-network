{
  "$id": "https://spec.aset.example/network/0.1/schemas/import-observation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "enforcement": {
      "const": "BLOCKED"
    },
    "evidence_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "import_id": {
      "maxLength": 256,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/\\-]*$",
      "type": "string"
    },
    "seed_scope": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "semantic_status": {
      "const": "UNKNOWN"
    },
    "target_context_id": {
      "maxLength": 256,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/\\-]*$",
      "type": "string"
    },
    "target_policy_epoch": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "target_state_root": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "import_id",
    "evidence_digest",
    "target_context_id",
    "target_state_root",
    "target_policy_epoch",
    "seed_scope",
    "semantic_status",
    "enforcement"
  ],
  "type": "object"
}
