{
  "$id": "https://spec.aset.example/network/0.1/schemas/network-state.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "history": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "array"
    },
    "imports": {
      "additionalProperties": {
        "$ref": "import-observation.schema.json"
      },
      "type": "object"
    }
  },
  "required": [
    "imports",
    "history"
  ],
  "type": "object"
}
