{
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "epoch": {
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:/-]+$",
      "type": "string"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "SUSPENDED",
        "WITHDRAWN"
      ]
    }
  },
  "$id": "https://spec.aset.example/network/0.1/schemas/common.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASET Network Extension common definitions"
}
