{
  "$id": "https://spec.aset.example/network/0.1/schemas/profile-binding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An immutable exact target-local binding of one profile digest. It contains no activation state and no resolution identifier. A fresh Seed ResolutionRequest is constructed from the declared projection; applicability is derived only from its target-local Seed result.",
  "properties": {
    "binding_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "profile_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "seed_scope": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "target_context_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "target_policy_epoch": {
      "$ref": "common.schema.json#/$defs/epoch"
    },
    "target_state_root": {
      "$ref": "common.schema.json#/$defs/digest"
    }
  },
  "required": [
    "binding_digest",
    "profile_digest",
    "target_context_id",
    "target_state_root",
    "target_policy_epoch",
    "seed_scope"
  ],
  "title": "ASET exact local profile binding",
  "type": "object"
}
