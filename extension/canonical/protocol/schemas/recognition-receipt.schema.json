{
  "$id": "https://spec.aset.example/network/0.1/schemas/recognition-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "semantic_status": {
            "const": "ACCEPT"
          }
        }
      },
      "then": {
        "properties": {
          "enforcement": {
            "const": "ALLOW"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "semantic_status": {
            "const": "DENY"
          }
        }
      },
      "then": {
        "properties": {
          "enforcement": {
            "const": "BLOCKED"
          }
        }
      }
    }
  ],
  "properties": {
    "enforcement": {
      "enum": [
        "ALLOW",
        "BLOCKED"
      ]
    },
    "import_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "question_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "recognition_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "resolution_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "scope_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "seed_record_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "semantic_status": {
      "enum": [
        "ACCEPT",
        "DENY"
      ]
    },
    "target_context_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "target_policy_epoch": {
      "$ref": "common.schema.json#/$defs/epoch"
    }
  },
  "required": [
    "recognition_id",
    "import_id",
    "target_context_id",
    "resolution_id",
    "question_digest",
    "scope_digest",
    "target_policy_epoch",
    "semantic_status",
    "enforcement",
    "seed_record_digest"
  ],
  "type": "object"
}
