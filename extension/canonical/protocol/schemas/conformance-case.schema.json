{
  "$id": "https://spec.aset.example/network/0.1/schemas/conformance-case.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "maxLength": 256,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/\\-]*$",
      "type": "string"
    },
    "expected": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "code": {
          "type": "string"
        },
        "enforcement": {
          "enum": [
            "BLOCKED",
            "NOT_APPLICABLE"
          ]
        },
        "semantic_status": {
          "enum": [
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "state_changed": {
          "type": "boolean"
        }
      },
      "required": [
        "accepted",
        "code",
        "state_changed",
        "semantic_status",
        "enforcement"
      ],
      "type": "object"
    },
    "initial_state": {
      "$ref": "network-state.schema.json"
    },
    "polarity": {
      "enum": [
        "positive",
        "negative"
      ]
    },
    "steps": {
      "items": {
        "$ref": "transition.schema.json"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "case_id",
    "polarity",
    "initial_state",
    "steps",
    "expected"
  ],
  "type": "object"
}
