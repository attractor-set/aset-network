{
  "$id": "https://spec.aset.example/network/0.1/schemas/transition.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "ADMIT_IMPORT"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "import": {
          "$ref": "import-observation.schema.json"
        }
      },
      "required": [
        "import"
      ],
      "type": "object"
    },
    "transition_id": {
      "maxLength": 256,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/\\-]*$",
      "type": "string"
    }
  },
  "required": [
    "transition_id",
    "kind",
    "payload"
  ],
  "type": "object"
}
