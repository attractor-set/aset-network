ASET-CAUSAL-NET 1 ASET-NETWORK-ALPHA4-CAUSAL
SEMANTIC-PRECEDENCE NONE
MODE STATE-TRANSITION

TRANSITION ADMIT-FRESH ASET-NETWORK-COMPONENT-ADMIT-FRESH
REQUIRE EXACT_IMPORT
REQUIRE FRESH_ID
EFFECT ADD_IMPORT
OUTPUT ACCEPTED TRUE
OUTPUT CODE IMPORT_ADMITTED
OUTPUT STATE_CHANGED TRUE
OUTPUT SEED_RECOGNITION UNKNOWN
OUTPUT SEED_EFFECT FALSE
END

TRANSITION ADMIT-REPLAY ASET-NETWORK-COMPONENT-ADMIT-REPLAY
REQUIRE EXACT_IMPORT
REQUIRE EXACT_REPLAY
EFFECT PRESERVE_IMPORTS
OUTPUT ACCEPTED TRUE
OUTPUT CODE IDEMPOTENT_REPLAY
OUTPUT STATE_CHANGED FALSE
OUTPUT SEED_RECOGNITION UNKNOWN
OUTPUT SEED_EFFECT FALSE
END

TRANSITION REJECT-CONFLICT ASET-NETWORK-COMPONENT-REJECT-CONFLICT
REQUIRE EXACT_IMPORT
REQUIRE CONFLICTING_ID
EFFECT PRESERVE_IMPORTS
OUTPUT ACCEPTED FALSE
OUTPUT CODE IDENTIFIER_CONFLICT
OUTPUT STATE_CHANGED FALSE
OUTPUT SEED_RECOGNITION NOT_APPLICABLE
OUTPUT SEED_EFFECT FALSE
END
